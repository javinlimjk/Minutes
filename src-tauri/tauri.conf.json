{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minutes",
  "version": "0.1.0",
  "identifier": "com.javinlim.minutes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minutes - 100% Offline AI Transcriber",
        "width": 1150,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost blob:; media-src 'self' asset: http://asset.localhost blob: data: http: https:; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../models/ggml-small.bin",
      "../models/ggml-small.en.bin"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "iOS": {
      "developmentTeam": "TA86847LRQ"
    }
  }
}
